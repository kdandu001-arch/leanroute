# --- Engine ---
LEANROUTE_ENGINE=laya          # laya | mock  (mock = keyword stand-in for UI dev, NOT a model)
LAYA_MODE=router              # router (auto-picks English/multilingual) | single
LAYA_MODEL=convaiinnovations/laya
# LAYA_DEVICE: cpu | cuda | mps  (blank = auto)
LAYA_DEVICE=

# --- Access ---
# LEANROUTE_API_KEYS: comma-separated. `project:key` gives each customer their own dashboard, e.g. acme:lr_abc,beta:lr_def. Blank = open (dev only!)
LEANROUTE_API_KEYS=
PUBLIC_PLAYGROUND=true        # allow anonymous /v1/decide from the website
PLAYGROUND_RPM=20             # anonymous requests per IP per minute
CORS_ORIGINS=*                # set to https://your-site.pages.dev in production

# --- LLM Cost Cutter gateway (/v1/chat/completions) ---
UPSTREAM_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible API (OpenAI, OpenRouter, Groq, Ollama...)
UPSTREAM_API_KEY=
CHEAP_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o
# USD per 1M tokens - set to your provider's CURRENT prices so savings are accurate
CHEAP_PRICE_IN=0.15
CHEAP_PRICE_OUT=0.60
STRONG_PRICE_IN=2.50
STRONG_PRICE_OUT=10.0
# GUARD_MODE: precise (default) = ProtectAI injection detector, fewest normal requests blocked.
#   broad = also block when Laya is very sure (catches more role-play jailbreaks, blocks some code).
#   laya = Laya only (both scores must reach LAYA_GUARD_THRESHOLD). off = no guard. See eval/results.md.
GUARD_MODE=precise
PROTECTAI_THRESHOLD=0.66
# LAYA_GUARD_THRESHOLD: blank = 0.99 in broad mode, 0.92 in laya mode
LAYA_GUARD_THRESHOLD=
ROUTER_EASY_MAX=1.2           # difficulty score (0-3) at or below this -> cheap model
# ROUTER_MIN_CONFIDENCE: optional; 0 = off. Laya's difficulty confidence is low for every prompt, so it doesn't separate easy from hard.
ROUTER_MIN_CONFIDENCE=0

# --- Savings dashboard ---
# LEANROUTE_DB: SQLite file for usage (blank = server/data/leanroute.db). Stores costs and counts, never prompt text.
LEANROUTE_DB=

# --- Response cache ---
# CACHE_TTL_SECONDS: answer identical requests (same project, same messages and settings) from storage for $0, for this many seconds. 0 = off.
# While on, LLM responses are stored in the database; prompts are stored only as a one-way hash.
CACHE_TTL_SECONDS=0

# --- Quality check (proves the savings) ---
# QUALITY_CHECK_RATE: share of cheap-model answers to double-check, e.g. 0.05 = 5%. The same request is sent to the
# strong model, which then judges whether the cheap answer was as good. Runs in the background after the user has
# their answer. The checks cost money (shown on the dashboard and subtracted from savings). 0 = off.
QUALITY_CHECK_RATE=0

# --- Router ---
# ROUTER: leanroute (default) = our router, trained on real graded cheap-model answers; laya = Laya difficulty score.
# ROUTER_THRESHOLD: lower = more cautious. 0.107 sends ~50% of traffic to the cheap model (94% good enough in eval/results.md);
# 0.067 ~30% (96%); 0.165 ~70% (92%). Laya still sends sensitive requests to the strong model.
ROUTER=leanroute
ROUTER_THRESHOLD=0.107

# --- Reliability and limits ---
# UPSTREAM_RETRIES: retries for provider overload (429), server errors (5xx) and network failures. If the cheap model
# still fails, the request falls back to the strong model automatically.
UPSTREAM_RETRIES=2
UPSTREAM_RETRY_BACKOFF=0.5
# PROJECT_RPM: requests per minute per project/API key (0 = off). Checked before any LLM call.
PROJECT_RPM=0
# Monthly spending caps in USD, checked before any LLM call. LEANROUTE_BUDGETS=acme:50,beta:10 sets per-project caps;
# BUDGET_MONTHLY_USD applies to every other project (0 = no cap). Over budget = HTTP 429.
LEANROUTE_BUDGETS=
BUDGET_MONTHLY_USD=0
