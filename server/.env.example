# --- Engine ---
LEANROUTE_ENGINE=laya          # laya | mock  (mock = keyword stand-in for UI dev, NOT a model)
LAYA_MODE=router              # router (auto-picks English/multilingual) | single
LAYA_MODEL=convaiinnovations/laya
# LAYA_DEVICE: cpu | cuda | mps  (blank = auto)
LAYA_DEVICE=

# --- Access ---
# LEANROUTE_API_KEYS: comma-separated. `project:key` gives each customer their own dashboard, e.g. acme:lr_abc,beta:lr_def. Blank = open (dev only!)
LEANROUTE_API_KEYS=
PUBLIC_PLAYGROUND=true        # allow anonymous /v1/decide from the website
PLAYGROUND_RPM=20             # anonymous requests per IP per minute
CORS_ORIGINS=*                # set to https://your-site.pages.dev in production

# --- LLM Cost Cutter gateway (/v1/chat/completions) ---
UPSTREAM_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible API (OpenAI, OpenRouter, Groq, Ollama...)
UPSTREAM_API_KEY=
CHEAP_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o
# USD per 1M tokens - set to your provider's CURRENT prices so savings are accurate
CHEAP_PRICE_IN=0.15
CHEAP_PRICE_OUT=0.60
STRONG_PRICE_IN=2.50
STRONG_PRICE_OUT=10.0
GUARD_BLOCK_THRESHOLD=0.85
ROUTER_EASY_MAX=1.2           # difficulty score (0-3) at or below this -> cheap model
# ROUTER_MIN_CONFIDENCE: optional; 0 = off. Laya's difficulty confidence is low for every prompt, so it doesn't separate easy from hard.
ROUTER_MIN_CONFIDENCE=0

# --- Savings dashboard ---
# LEANROUTE_DB: SQLite file for usage (blank = server/data/leanroute.db). Stores costs and counts, never prompt text.
LEANROUTE_DB=
